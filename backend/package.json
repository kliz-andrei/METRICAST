{
    "name":  "@metricast/backend",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "typecheck":  "tsc --noEmit",
                    "lint":  "eslint src --max-warnings=0",
                    "db:generate":  "prisma generate --schema ../database/prisma/schema.prisma",
                    "db:migrate":  "prisma migrate deploy --schema ../database/prisma/schema.prisma",
                    "db:seed":  "tsx src/database/seed.ts",
                    "import:csv":  "tsx src/database/import-pos.ts",
                    "start":  "node dist/server.js",
                    "dev":  "tsx watch src/server.ts"
                },
    "dependencies":  {
                         "@prisma/client":  "^6.7.0",
                         "bcryptjs":  "^3.0.3",
                         "cors":  "^2.8.6",
                         "csv-parse":  "^5.6.0",
                         "dotenv":  "^16.5.0",
                         "express":  "^5.2.1",
                         "express-rate-limit":  "^8.6.1",
                         "helmet":  "^8.3.0",
                         "jsonwebtoken":  "^9.0.3",
                         "pino":  "^10.3.1",
                         "pino-http":  "^11.0.0",
                         "swagger-jsdoc":  "^6.3.0",
                         "swagger-ui-express":  "^5.0.1",
                         "zod":  "^3.24.3"
                     },
    "devDependencies":  {
                            "@eslint/js":  "^9.25.1",
                            "@types/cors":  "^2.8.19",
                            "@types/express":  "^5.0.6",
                            "@types/jsonwebtoken":  "^9.0.10",
                            "@types/node":  "^22.15.3",
                            "@types/swagger-jsdoc":  "^6.0.4",
                            "@types/swagger-ui-express":  "^4.1.8",
                            "eslint":  "^9.25.1",
                            "globals":  "^16.0.0",
                            "prisma":  "^6.7.0",
                            "tsx":  "^4.19.3",
                            "typescript":  "^5.8.3",
                            "typescript-eslint":  "^8.30.1"
                        },
    "prisma":  {
                   "seed":  "tsx src/database/seed.ts"
               },
    "allowScripts":  {
                         "esbuild@0.28.1":  true,
                         "prisma@6.19.3":  true,
                         "@prisma/client@6.19.3":  true,
                         "@prisma/engines@6.19.3":  true
                     }
}