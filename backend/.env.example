DATABASE_URL="postgresql://metricast:change-me@localhost:5432/metricast?schema=public"
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30
JWT_REFRESH_COOKIE_NAME="metricast_refresh"
PASSWORD_RESET_TTL_MINUTES=30
CORS_ORIGIN="http://localhost:5173"
FORECAST_PYTHON_PATH=""
# auto uses the remote service only in production when URL and token are set.
# Use local or remote to force a provider explicitly.
FORECAST_SERVICE_MODE=auto
FORECAST_SERVICE_URL=""
FORECAST_SERVICE_TOKEN=""
FORECAST_SERVICE_TIMEOUT_MS=55000
TRUST_PROXY=false

SEED_ADMIN_EMAIL="admin@underthebalete.com"
SEED_ADMIN_PASSWORD="ChangeThisBeforeProduction!"
